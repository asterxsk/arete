# Ignore everything by default
*

# Un-ignore specific root files
!.gitignore
!AGENTS.md
!install.sh
!install.ps1
!LICENSE
!README.md
!version.txt
!web-search.json

# Un-ignore repo tooling / CI / docs infrastructure
!package.json
!package-lock.json
!tsconfig.json
!eslint.config.mjs
!.prettierrc.json
!.prettierignore
!vitest.config.ts
!.jscpd.json
!.husky/**
!.github/**
!.devcontainer/**
!docs/**

# Un-ignore agent folder
!agent/

# Un-ignore specific files and folders inside agent/
!agent/keybindings.json
!agent/extensions/
!agent/themes/

# Explicitly ignore specific files and folder inside agent/
agent/extensions/9router-provider/models-cache.json

# Un-ignore everything recursively inside extensions and themes
!agent/extensions/**
!agent/themes/**

# Re-ignore specific things inside extensions
agent/extensions/commandcode-provider/
agent/extensions/kimchi-provider/
agent/extensions/**/docs/
agent/extensions/9router-provider/models_cache.json

# Re-ignore filechanges node_modules (accidentally staged — use git rm --cached)
agent/extensions/filechanges/node_modules/

# Ignore all node_modules inside extensions
agent/extensions/**/node_modules/*

# Explicitly ignore crash log (though * already ignores it, being explicit)
agent/pi-crash.log

# Secrets, environment, IDE, and OS files
.env
.env.*
!.env.example
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
*.log
coverage/
.nyc_output/
reports/
