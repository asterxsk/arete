# Arete local environment template
# Copy to `.env` and fill in. These are consumed by individual extensions at runtime.
# Never commit your real `.env`.

# Video extraction (video-extract extension)
GEMINI_API_KEY=

# 9router provider (9router-provider extension) — optional remote gateway
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=

# Profile switcher OAuth secrets (profile-switcher extension)
PI_OAUTH_CLIENT_ID=
PI_OAUTH_CLIENT_SECRET=

# Optional: enable debug logging across extensions
ARETE_DEBUG=
